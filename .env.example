# Steam Configuration
# Steam WebAPI Key (required to fetch owned games)
# Get one at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_webapi_key_here

# Twitch Configuration
# Register an app at https://dev.twitch.tv/console to get these
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Optional fallback for the "Update stream info" button.
# The app can now get a user token through the Connect Twitch button.
# TWITCH_BROADCASTER_ID=your_twitch_login_or_user_id_here

# Steam User Configuration
# Find your Steam user ID from your profile URL or from Steam userdata folder
STEAM_USER_ID=your_steam_user_id_here

# Optional diagnostics only. This reads local Steam app state, which can look like
# installed/recent apps instead of your owned library. Keep disabled for normal use.
# ALLOW_LOCAL_APP_FALLBACK=false

# Optional cache tuning
# OWNED_GAMES_CACHE_TTL=86400
# VIEWER_COUNT_CACHE_TTL=600

# Multi-platform configuration (comma-separated: steam,gog,epic)
# ENABLED_PLATFORMS=steam,gog,epic

# Optional GOG Galaxy database path override
# GOG_DB_PATH=

# Optional Epic Games catalog path overrides
# EPIC_CATALOG_PATH=
# EPIC_INSTALLS_PATH=

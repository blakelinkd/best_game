# Steam Configuration
# Steam WebAPI Key (required to fetch owned games)
# Get one at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_webapi_key_here

# Twitch Configuration
# Register an app at https://dev.twitch.tv/console to get these
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
# Optional. Leave blank to use the app's local HTTPS callback URL.
# TWITCH_REDIRECT_URI=https://localhost:5000/auth/twitch/callback

# Optional Twitch username fallback for the "Update stream info" button.
# The app can now get a user token through the Connect Twitch button.
# TWITCH_BROADCASTER_ID=your_twitch_username_here

# Steam User Configuration
# Use your custom profile name, profile URL, SteamID64, or Steam userdata folder ID.
# The Settings page can resolve custom names after you enter your Steam Web API key.
STEAM_USER_ID=your_steam_profile_name_or_id_here

# Optional cache tuning
# OWNED_GAMES_CACHE_TTL=86400
# VIEWER_COUNT_CACHE_TTL=600

# Multi-platform configuration (comma-separated: steam,gog,epic)
# ENABLED_PLATFORMS=steam,gog,epic

# Optional retro console libraries. Run retro_collector.py first to create
# cache/retro_games.json. Use "all" or a comma-separated subset:
# nes,snes,n64,gamecube,gameboy,gbc,gba,genesis,saturn,dreamcast,ps1,ps2,3do
# RETRO_SYSTEMS=

# Optional GOG Galaxy database path override
# GOG_DB_PATH=

# Optional Epic Games catalog path overrides
# EPIC_CATALOG_PATH=
# EPIC_INSTALLS_PATH=

# Optional Ollama settings for AI tag generation
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Recommended: qwen3.5:4b (fast cold-load, strong JSON output). Leave blank to
# auto-detect the first model installed in Ollama.
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_TIMEOUT=60

# First-run onboarding flag. Set to false after completing the setup wizard.
# Remove this line or set it to true to re-run the onboarding flow.
# FIRST_RUN=true
